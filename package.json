{
  "name": "macrovox",
  "version": "1.0.9",
  "description": "MacroVox: Real-time voice dictation with AI cleanup",
  "author": "OK Studio",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "tauri build",
    "build:renderer": "vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:versions": "node scripts/check-tauri-versions.mjs",
    "release:linux": "mkdir -p release/linux && cp -v src-tauri/target/release/bundle/deb/*.deb src-tauri/target/release/bundle/rpm/*.rpm release/linux/ 2>/dev/null; cp -v src-tauri/target/release/bundle/appimage/*.AppImage src-tauri/target/release/bundle/appimage/*.AppImage.sig src-tauri/target/release/bundle/appimage/*.AppImage.tar.gz* release/linux/ 2>/dev/null; ls -lh release/linux/",
    "release:windows": "node -e \"const fs=require('fs'),path=require('path');fs.mkdirSync('release/windows',{recursive:true});const src='src-tauri/target/release/bundle';['nsis','msi'].forEach(d=>{const dir=path.join(src,d);if(fs.existsSync(dir))for(const f of fs.readdirSync(dir))if(/(\\.exe|\\.exe\\.sig|\\.msi|\\.msi\\.sig)$/.test(f))fs.copyFileSync(path.join(dir,f),path.join('release/windows',f))});console.log(fs.readdirSync('release/windows'))\"",
    "release:manifest": "node scripts/generate-latest.mjs",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p config/tsconfig.functions.json",
    "check:csp": "node scripts/check-csp.mjs",
    "test:scripts": "node --test scripts/__tests__/*.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.51.0",
    "@deepgram/sdk": "^3.9.0",
    "@netlify/functions": "^2.8.2",
    "@supabase/supabase-js": "^2.105.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.9.3",
    "vite": "^6.0.3",
    "vitest": "^4.0.18"
  }
}

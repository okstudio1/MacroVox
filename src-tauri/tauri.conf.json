{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacroVox",
  "version": "1.0.9",
  "identifier": "com.okstudio.macrovox",
  "build": {
    "beforeDevCommand": "npm run dev:renderer",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:renderer",
    "frontendDist": "../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "dictation.html",
        "title": "MacroVox",
        "width": 380,
        "height": 360,
        "minWidth": 380,
        "minHeight": 360,
        "decorations": false,
        "alwaysOnTop": true,
        "backgroundColor": "#0f172a",
        "visible": false
      },
      {
        "label": "settings",
        "url": "settings.html",
        "title": "Settings \u2014 MacroVox",
        "width": 480,
        "height": 700,
        "minWidth": 400,
        "minHeight": 500,
        "backgroundColor": "#0a0f14",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://hlioqbizljywisvnbtat.supabase.co https://macrovox.tech https://api.deepgram.com wss://api.deepgram.com https://api.anthropic.com; img-src 'self' data:; font-src 'self' data:; media-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/okstudio1/macrovox-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCOTFGMjNBNDlFMDI0NkQKUldSdEpPQkpPdktSbXljcjZCcEp1ZUFOOXdkWkVrbEdPY3Y0L1FPWExrU1N0bURxWjQ4bTRNbVgK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Real-time voice dictation with AI cleanup",
    "longDescription": "MacroVox is a managed voice dictation app powered by Deepgram and Claude. Speak into your microphone and get instantly cleaned-up text in any application.",
    "copyright": "\u00a9 2026 OK Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [],
    "windows": {
      "signCommand": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ../scripts/sign-windows.ps1 -Path %1",
      "nsis": {
        "headerImage": "installer/windows/installer-header.bmp",
        "sidebarImage": "installer/windows/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "startMenuFolder": "MacroVox",
        "installerHooks": "installer/windows/installer-hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "section": "sound",
        "priority": "optional",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libasound2",
          "libpulse0"
        ],
        "recommends": [
          "libayatana-appindicator3-1"
        ],
        "desktopTemplate": "installer/linux/macrovox.desktop"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "alsa-lib",
          "pulseaudio-libs"
        ],
        "desktopTemplate": "installer/linux/macrovox.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
